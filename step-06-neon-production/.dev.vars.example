# Local-only secrets go here (copy to .dev.vars). Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
MIGRATION_TOKEN=replace-with-a-random-migration-token
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/learn_mcp?sslmode=require
NEON_CONNECTOR_DATABASE_URL=postgresql://connector:password@ep-example.neon.tech/learn_mcp?sslmode=require
