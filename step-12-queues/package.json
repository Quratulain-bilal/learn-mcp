    "db:status": "tsx scripts/migrate.ts --status",
    "db:seed": "tsx scripts/seed-company.ts",
    "db:connector": "tsx scripts/create-connector.ts",
    "hyperdrive:create": "tsx scripts/create-hyperdrive.ts",
    "tenant:dedicate": "tsx scripts/dedicate-tenant.ts",
    "embed": "tsx scripts/embed.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "build:widgets": "tsx scripts/build-widgets.ts",
    "predev": "npm run build:assets",
    "pretest": "npm run build:assets",
    "predeploy": "npm run build:assets",
    "pretypecheck": "npm run build:assets",
    "preview:widgets": "npm run build:widgets && vite --config vite.preview.config.ts",
