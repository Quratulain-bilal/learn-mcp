# Copy this file to .env (git ignores it). Local database settings for this step.
# Both point at this step's Neon branch (step-06), or at a dev branch made from it.
# Use the DIRECT host (without "-pooler"): Hyperdrive does the pooling.

# The OWNER role (neondb_owner): runs migrations and the seed script. Never used by the Worker.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:replace-me@ep-replace-me.neon.tech/neondb?sslmode=verify-full

# The least-privilege role the Worker uses. `npm run db:connector` fills this in for you.
# Wrangler uses it as the local stand-in for the HYPERDRIVE binding (wrangler dev, tests).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://mcp_connector:replace-me@ep-replace-me.neon.tech/neondb?sslmode=verify-full

# Dedicated (enterprise) tenant databases. `npm run tenant:dedicate -- --name enterprise`
# creates the database tenant_enterprise on the same branch and fills these in:
# MIGRATION_DATABASE_URL_TENANT_DB_ENTERPRISE=postgresql://neondb_owner:...@.../tenant_enterprise?sslmode=verify-full
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_TENANT_DB_ENTERPRISE=postgresql://mcp_connector:...@.../tenant_enterprise?sslmode=verify-full
