{
  "about": "30 realistic prompts from a sales manager (admin) and staff (member). For each: the tool the model should call first, key arguments, and the widget that should appear (null = text only). Run in each client before a release; record results in EVALS.md.",
  "prompts": [
    { "id": 1, "who": "staff", "prompt": "Show me our latest orders.", "tool": "list_orders", "args": {}, "widget": "orders-table" },
    { "id": 2, "who": "staff", "prompt": "Which orders did Ayesha Khan place?", "tool": "list_orders", "args": { "customer": "ayesha" }, "widget": "orders-table" },
    { "id": 3, "who": "staff", "prompt": "Find orders with the cable organizer kit.", "tool": "list_orders", "args": { "product": "cable organizer" }, "widget": "orders-table" },
    { "id": 4, "who": "staff", "prompt": "What is in order SO-0042?", "tool": "get_order", "args": { "order_ref": "SO-0042" }, "widget": null },
    { "id": 5, "who": "manager", "prompt": "How did sales go month by month in 2025?", "tool": "get_sales_summary", "args": { "group_by": "month" }, "widget": "sales-chart" },
    { "id": 6, "who": "manager", "prompt": "Who are our five biggest customers this year?", "tool": "get_sales_summary", "args": { "group_by": "customer", "limit": 5 }, "widget": "sales-chart" },
    { "id": 7, "who": "manager", "prompt": "Which products bring in the most revenue?", "tool": "get_sales_summary", "args": { "group_by": "product" }, "widget": "sales-chart" },
    { "id": 8, "who": "manager", "prompt": "What is our average order value?", "tool": "answer_business_question", "args": { "question": "average_order_value" }, "widget": null },
    { "id": 9, "who": "manager", "prompt": "Which products have never sold?", "tool": "answer_business_question", "args": { "question": "products_never_sold" }, "widget": null },
    { "id": 10, "who": "manager", "prompt": "Which customers came back more than once?", "tool": "answer_business_question", "args": { "question": "repeat_customers" }, "widget": null },
    { "id": 11, "who": "manager", "prompt": "Explain how our sales data is organised.", "tool": "describe_schema", "args": {}, "widget": null },
    { "id": 12, "who": "manager", "prompt": "Why did the old spreadsheet give one customer two cities?", "tool": "compare_designs", "args": { "check": "customer_city" }, "widget": null },
    { "id": 13, "who": "staff", "prompt": "Can I give a new customer 12% off without asking anyone?", "tool": "search_sales_policy", "args": {}, "widget": null },
    { "id": 14, "who": "staff", "prompt": "The customer opened the box; can they still return it?", "tool": "search_sales_policy", "args": {}, "widget": null },
    { "id": 15, "who": "staff", "prompt": "What is the office dress code on Fridays?", "tool": "search_sales_policy", "args": {}, "widget": null, "expect": "abstains" },
    { "id": 16, "who": "staff", "prompt": "Do we sell anything to keep medicine cold?", "tool": "find_products", "args": {}, "widget": null },
    { "id": 17, "who": "staff", "prompt": "Create an order for laura.schmidt@example.com: 2 Desk Lamps.", "tool": "create_order", "args": { "customer_email": "laura.schmidt@example.com" }, "widget": null, "expect": "confirms first" },
    { "id": 18, "who": "staff", "prompt": "I want to enter a new order.", "tool": "open_order_form", "args": {}, "widget": "order-form" },
    { "id": 19, "who": "staff", "prompt": "Start an order for Laura with two desk lamps; I will add more later.", "tool": "add_to_draft", "args": { "product": "Desk Lamp", "quantity": 2 }, "widget": null },
    { "id": 20, "who": "staff", "prompt": "What is in my draft order?", "tool": "view_draft", "args": {}, "widget": null },
    { "id": 21, "who": "staff", "prompt": "Import these orders: <paste samples/orders-import.csv>", "tool": "bulk_import_orders", "args": {}, "widget": null, "expect": "confirms first" },
    { "id": 22, "who": "staff", "prompt": "How is my import going?", "tool": "get_import_status", "args": {}, "widget": null },
    { "id": 23, "who": "manager", "prompt": "Build our 2025 sales report.", "tool": "start_sales_report", "args": { "year": 2025 }, "widget": "task-status" },
    { "id": 24, "who": "manager", "prompt": "Approve the report.", "tool": "approve_report", "args": {}, "widget": null },
    { "id": 25, "who": "manager", "prompt": "Change our currency to EUR.", "tool": "update_company_settings", "args": { "currency": "EUR" }, "widget": null },
    { "id": 26, "who": "staff", "prompt": "Change our currency to EUR.", "tool": "update_company_settings", "args": { "currency": "EUR" }, "widget": null, "expect": "Forbidden (403)" },
    { "id": 27, "who": "manager", "prompt": "Who is in my company?", "tool": "list_company_members", "args": {}, "widget": null },
    { "id": 28, "who": "manager", "prompt": "Remove sara@example.com from the company.", "tool": "remove_member", "args": { "email": "sara@example.com", "confirm": true }, "widget": null, "expect": "asks to confirm before calling" },
    { "id": 29, "who": "staff", "prompt": "What is new? Any recent orders or milestones?", "tool": "list_recent_events", "args": {}, "widget": null },
    { "id": 30, "who": "staff", "prompt": "Which companies am I in, and how do I switch?", "tool": "list_my_companies", "args": {}, "widget": null }
  ]
}
