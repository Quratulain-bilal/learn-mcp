{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-mcp-step-07-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "learn-mcp-step-06-auth",
