{
  "$schema": "node_modules/wrangler/config-schema.json",
  // THREE ENVIRONMENTS, one Worker codebase:
  //   dev         `npm run dev` / `npm test`: this top-level config, run locally (local D1,
  //               KV, queues, Durable Objects, Workflows; Neon through the strings in .env)
  //   production  `npm run deploy:production`: this top-level config, deployed as learn-mcp-step-18
  //   staging     `npm run deploy:staging`: env.staging below, deployed as learn-mcp-step-18-staging
  //
  // Bindings are NOT inherited by an environment, so env.staging repeats every one of them,
  // pointing at STAGING's own resources: its own D1 (sign-in data), Neon databases
  // (through its own Hyperdrive configs), KV, queues, Workflow and Durable Objects.
  // Nothing is shared between staging and production: no users, tenants, settings or data.
  "name": "learn-mcp-step-18",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Preview URLs would expose untested versions on public URLs: off.
  "preview_urls": false,
  // Workers Logs (every console line, as searchable JSON) and automatic traces of every
  // request and its outgoing calls. Head sampling 1 = keep everything (fine at this scale;
  // lower it if logs get expensive). Step 17's named spans add the company and request id.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // A custom domain (paid: you need to own a domain on Cloudflare) would go here:
  //   "routes": [{ "pattern": "mcp.example.com", "custom_domain": true }],
  // This course stays on free workers.dev URLs.

  "vars": { "EMBEDDINGS": "workers-ai", "ENVIRONMENT": "production" },
  "ai": { "binding": "AI", "remote": true },
  // PRODUCTION data: the step 8 databases (shared tier + dedicated enterprise tier).
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "2be047466cc74e8b8479e7aa3deaeb83" },
    { "binding": "TENANT_DB_ENTERPRISE", "id": "888780cb6e784823a7447d4defb6bb53" }
  ],
  "durable_objects": { "bindings": [{ "name": "USER_STATE", "class_name": "UserState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserState"] }],
  "queues": {
    "producers": [
      { "binding": "ORDER_IMPORTS", "queue": "order-imports-step-18" },
      { "binding": "SALES_EVENTS", "queue": "sales-events-step-18" }
    ],
    "consumers": [
      { "queue": "order-imports-step-18", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "order-imports-dlq" },
      { "queue": "sales-events-step-18", "max_batch_size": 25, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "sales-events-dlq" }
    ]
  },
  "workflows": [{ "name": "learn-mcp-step-18-sales-report", "binding": "SALES_REPORT", "class_name": "SalesReportWorkflow" }],
  // Created by the first deploy (automatic provisioning), then pinned.
  "kv_namespaces": [{ "binding": "TENANT_CACHE", "id": "4b97a6e9b8b741ca82dff74942dcdd0a" }],
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "learn-mcp-auth", "database_id": "01b7788b-f97f-4970-9032-3d2448e8889a", "migrations_dir": "migrations" }
  ],

  "env": {
    "staging": {
      // Deployed as learn-mcp-step-18-staging (wrangler adds the environment name).
      "vars": { "EMBEDDINGS": "workers-ai", "ENVIRONMENT": "staging" },
      "ai": { "binding": "AI", "remote": true },
      // STAGING data: step18_staging and step18_staging_enterprise on the Neon branch.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "d6bc9e4dac43463297cd98df2b084fb9" },
        { "binding": "TENANT_DB_ENTERPRISE", "id": "6e7fd2000a1c4d7580534e2b4b415db5" }
      ],
      "durable_objects": { "bindings": [{ "name": "USER_STATE", "class_name": "UserState" }] },
      "queues": {
        "producers": [
          { "binding": "ORDER_IMPORTS", "queue": "order-imports-step-18-staging" },
          { "binding": "SALES_EVENTS", "queue": "sales-events-step-18-staging" }
        ],
        "consumers": [
          { "queue": "order-imports-step-18-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "order-imports-dlq" },
          { "queue": "sales-events-step-18-staging", "max_batch_size": 25, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "sales-events-dlq" }
        ]
      },
      "workflows": [{ "name": "learn-mcp-step-18-staging-sales-report", "binding": "SALES_REPORT", "class_name": "SalesReportWorkflow" }],
      "kv_namespaces": [{ "binding": "TENANT_CACHE", "id": "688fd56594554baa8b65229618e8dbfc" }],
      "d1_databases": [
        { "binding": "AUTH_DB", "database_name": "learn-mcp-auth-staging", "database_id": "7118e282-901a-40e2-90bc-051fbdbda6d4", "migrations_dir": "migrations" }
      ]
    }
  }
}
