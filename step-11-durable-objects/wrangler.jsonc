{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Each course step deploys as its own Worker so earlier steps stay live while graded.
  "name": "learn-mcp-step-11",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // The agents, MCP SDK and Better Auth packages use a few Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Business data lives in Neon Postgres, reached through Hyperdrive (pooled connections).
  // The Hyperdrive config holds the connection string for the least-privilege role
  // mcp_connector, so the secret lives in Cloudflare, not here. Create it once with
  //   npm run hyperdrive:create
  // and paste the id it prints below. Query caching is OFF for this config: a cache that
  // can't see app.tenant_id could hand one company another company's rows (lesson 19.9).
  // Locally, `wrangler dev` and the tests use the connection string in .env instead
  // (CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE).
  // Steps 9-20 share step 8's databases and Hyperdrive configs: their migrations only ADD
  // tables, so earlier steps keep working, and the free plan's Hyperdrive limit isn't hit.
  // Each step has its own KV cache.
  "hyperdrive": [
    // The SHARED database: every shared-tier company, plus the tenants table that says
    // where each company lives.
    { "binding": "HYPERDRIVE", "id": "11119ead677848309d803b5571fd3c3e" },
    // One DEDICATED database per enterprise company (TENANCY.md). Its binding name is
    // stored in the tenants table. `npm run tenant:dedicate` creates the database.
    { "binding": "TENANT_DB_ENTERPRISE", "id": "11119ead677848309d803b5571fd3c3e" }
  ],
  // Workers AI, for embeddings (bge-m3). Always runs on Cloudflare, even in wrangler dev,
  // and counts against the free daily allowance.
  "ai": { "binding": "AI", "remote": true },
  // "workers-ai" = the real model. Tests set EMBEDDINGS to "test" (see vitest.config.ts).
  "vars": { "EMBEDDINGS": "workers-ai" },
  // Per-user state (draft order, rate limit): one UserState Durable Object per user in a
  // company, named org:<orgId>:user:<userId>. new_sqlite_classes = SQLite-backed objects,
  // the kind the free plan supports.
  "durable_objects": { "bindings": [{ "name": "USER_STATE", "class_name": "UserState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserState"] }],
  // Per-company caches (settings, placement), always under org:<orgId>:... keys.
  // Created by the first `wrangler deploy` (automatic provisioning); its id is pinned here
  // so later deploys reuse it. In your own fork, delete the id and deploy once to get yours.
  "kv_namespaces": [{ "binding": "TENANT_CACHE", "id": "0dd82a521aaa4b709bb0964440121800" }],
  // D1 holds ONLY auth data: users, sessions, companies (organizations), members and
  // OAuth clients/tokens. Apply the schema with:
  //   npx wrangler d1 migrations apply learn-mcp-step-11-auth --local   (local)
  //   npx wrangler d1 migrations apply learn-mcp-step-11-auth --remote  (after deploying)
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "learn-mcp-step-11-auth",
      "database_id": "6290c62d-da35-4584-9b09-ad54eb2fc540",
      "migrations_dir": "migrations"
    }
  ]
}
